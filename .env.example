PORT=5000
# URL del frontend para permitir CORS (ej: https://mifrontend.onrender.com)
FRONTEND_URL=https://mifrontend.onrender.com
# Cadena de conexión de MongoDB (local o MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/pc_builder
# Secreto para firmar tokens JWT
JWT_SECRET=cambia_este_secreto
# Duración del token (opcional, por defecto 7d)
JWT_EXPIRES_IN=7d